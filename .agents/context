#!/usr/bin/env sh
# .agents/context - output structured repository context, toolchains, and agent environment
set -eu
_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
. "${_dir}/_common.sh"

apply_telemetry_guards
current_branch="$(git branch --show-current 2>/dev/null || echo "detached")"
head_commit="$(git rev-parse --short HEAD 2>/dev/null || echo "none")"
developer_profile="${DEVELOPER_PROFILE:-personal}"
preferred_agent="${CODE_AGENT:-agy}"

log_info "repository context overview"
printf '  repo_root:         %s\n' "$REPO_ROOT"
printf '  current_branch:    %s\n' "$current_branch"
printf '  head_commit:       %s\n' "$head_commit"
printf '  developer_profile: %s\n' "$developer_profile"
printf '  preferred_agent:   %s\n' "$preferred_agent"
printf '  telemetry_status:  suppressed\n'

printf '  detected_tooling:\n'
[ -f "${REPO_ROOT}/flake.nix" ] && printf '    - nix (flake)\n'
[ -f "${REPO_ROOT}/Cargo.toml" ] && printf '    - rust (cargo)\n'
[ -f "${REPO_ROOT}/package.json" ] && printf '    - node/javascript\n'
[ -f "${REPO_ROOT}/pyproject.toml" ] && printf '    - python (pyproject)\n'
[ -f "${REPO_ROOT}/go.mod" ] && printf '    - go\n'
[ -f "${REPO_ROOT}/.trunk/trunk.yaml" ] && printf '    - trunk linter\n'
