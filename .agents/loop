#!/usr/bin/env sh
# .agents/loop - invoke continuous autonomous loop orchestrator
set -eu
_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
. "${_dir}/_common.sh"

apply_telemetry_guards

if command -v agent-loop >/dev/null 2>&1; then
  exec agent-loop "$@"
fi

# Fallback to local python orchestrator if present in repository
orchestrator="${REPO_ROOT}/modules/home/agents/orchestration/continuous-agent/agent_loop.py"
if [ -f "$orchestrator" ] && command -v python3 >/dev/null 2>&1; then
  exec python3 "$orchestrator" "$@"
fi

log_error "neither 'agent-loop' nor 'python3' with local orchestrator found"
exit 127
