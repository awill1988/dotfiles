{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Activate: WSL",
      "type": "shell",
      "command": "nix build .#homeConfigurations.debianWsl.activationPackage && ./result/activate",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build: macOS",
      "type": "shell",
      "command": "nix build .#darwinConfigurations.macbook-arm.system",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Activate: macOS",
      "type": "shell",
      "command": "./result/sw/bin/darwin-rebuild switch --flake .#macbook-arm",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
