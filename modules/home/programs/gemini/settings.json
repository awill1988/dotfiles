{
  "$schema": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json",
  "mcpServers": {
    "github": {
      "httpUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer $GITHUB_MCP_PAT"
      }
    }
  },
  "context": {
    "fileName": ["AGENTS.md", "CONTEXT.md", "GEMINI.md"]
  },
  "general": {
    "disableAutoUpdate": true,
    "disableUpdateNag": true
  },
  "telemetry": {
    "enabled": false,
    "target": "local",
    "logPrompts": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "tools": {
    "allowed": [
      "run_shell_command(curl)",
      "run_shell_command(aws)",
      "run_shell_command(gh)",
      "run_shell_command(docker)",
      "run_shell_command(ls)",
      "run_shell_command(cat)",
      "run_shell_command(head)",
      "run_shell_command(tail)",
      "run_shell_command(grep)",
      "run_shell_command(find)",
      "run_shell_command(which)",
      "run_shell_command(file)",
      "run_shell_command(wc)",
      "run_shell_command(echo)",
      "run_shell_command(ps)",
      "run_shell_command(env)",
      "run_shell_command(whoami)",
      "run_shell_command(pwd)"
    ]
  }
}
