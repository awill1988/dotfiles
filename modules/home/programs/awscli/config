[profile awill]
sso_start_url=https://awill.awsapps.com/start
sso_region=us-east-1
sso_account_id=463509296941
sso_role_name=AWSAdministratorAccess

[profile reinadonia]
role_arn=arn:aws:iam::915541334192:role/Administrator
include_profile=master

[profile master]
source_profile=awill

[profile admin]
source_profile=awill
role_arn=arn:aws:iam::463509296941:role/Master-Role
credential_process=aws-vault exec --no-session --json default

[profile arro]
region = us-west-2

[profile arro-staging]
credential_process=aws-vault exec --json arro

[profile arro-production]
role_arn=arn:aws:iam::920511256258:role/OrganizationAccountAccessRole
source_profile = arro-staging

[profile arro-learning-staging]
role_arn=arn:aws:iam::440971295147:role/OrganizationAccountAccessRole
source_profile = arro-staging

[profile arro-learning-production]
role_arn=arn:aws:iam::339712880231:role/OrganizationAccountAccessRole
source_profile = arro-staging
