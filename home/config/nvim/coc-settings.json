{
  "suggest.noselect": false,
  "suggest.enablePreselect": true,
  "suggest.completionItemKindLabels": {
    "keyword": "\uf1de",
    "variable": "\ue79b",
    "value": "\uf89f",
    "operator": "\u03a8",
    "function": "\u0192",
    "reference": "\ufa46",
    "constant": "\uf8fe",
    "method": "\uf09a",
    "struct": "\ufb44",
    "class": "\uf0e8",
    "interface": "\uf417",
    "text": "\ue612",
    "enum": "\uf435",
    "enumMember": "\uf02b",
    "module": "\uf40d",
    "color": "\ue22b",
    "property": "\ue624",
    "field": "\uf9be",
    "unit": "\uf475",
    "event": "\ufacd",
    "file": "\uf723",
    "folder": "\uf114",
    "snippet": "\ue60b",
    "typeParameter": "\uf728",
    "default": "\uf29c"
  },
  "diagnostic.errorSign": "✘",
  "diagnostic.warningSign": "⚠",
  "diagnostic.infoSign": "ℹ",
  "diagnostic.hintSign": "➤",
  "coc.preferences.formatOnSaveFiletypes": [
    "go",
    "rust",
    "python",
    "typescript",
    "javascript",
    "json",
    "yaml"
  ],
  "languageserver": {
    "powershell": {
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "& { $null = Import-Module PowerShellEditorServices; Start-EditorServices -HostName 'nvim' -HostProfileId 'nvim' -HostVersion '1.0.0' -BundledModulesPath (Join-Path (Get-Module PowerShellEditorServices -ListAvailable | Sort-Object Version -Descending | Select-Object -First 1).ModuleBase 'PowerShellEditorServices') -SessionDetailsPath (New-TemporaryFile).FullName -LogPath (Join-Path ([System.IO.Path]::GetTempPath()) 'pses.log') -LogLevel Normal -Stdio }"
      ],
      "filetypes": ["ps1", "psm1", "psd1"],
      "rootPatterns": ["*.psd1", ".git/"]
    },
    "vale": {
      "command": "vale-ls",
      "filetypes": ["markdown", "text", "gitcommit"],
      "initializationOptions": {}
    }
  },
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.scriptAnalysis.enable": true,
  "go.goplsOptions": {
    "completeUnimported": true,
    "usePlaceholders": true,
    "analyses": {
      "unusedparams": true
    }
  },
  "rust-analyzer.checkOnSave.command": "clippy",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": true,
  "python.formatting.provider": "black"
}
