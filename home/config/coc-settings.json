{
  "languageserver": {
    "nix": {
      "command": "nil",
      "filetypes": ["nix"],
      "rootPatterns": ["flake.nix", "flake.lock", ".git"],
      "settings": {
        "nil": {
          "formatting": {
            "command": ["nixfmt"]
          }
        }
      }
    },
    "markdown": {
      "command": "marksman",
      "args": ["server"],
      "filetypes": ["markdown"],
      "rootPatterns": [".git", ".marksman.toml"]
    }
  }
}
